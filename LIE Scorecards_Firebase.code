/**
 * BMAssistent / LIE Scorecard - Micro Backend API (Nur E-Mail Service)
 * Code.js
 */

function doGet(e)
{
    try
    {
        if (!e || !e.parameter || !e.parameter.data)
        {
            return ContentService.createTextOutput("Micro-Backend aktiv. E-Mail API bereit.")
                .setMimeType(ContentService.MimeType.TEXT);
        }

        const body = JSON.parse(e.parameter.data);
        const action = body.action;
        const callback = e.parameter.callback;

        let result;

        switch (action)
        {
            case 'sendTempPinEmail':
                // Frontend generiert die Temp-PIN, GAS versendet sie nur noch
                result = sendTempPinEmail(body.spielerId, body.tempPin);
                break;

            default:
                throw new Error("Unbekannte Action: " + action);
        }

        const jsonResponse = JSON.stringify({ success: (!result.error), ...result });

        if (callback)
        {
            return ContentService.createTextOutput(callback + "(" + jsonResponse + ")")
                .setMimeType(ContentService.MimeType.JAVASCRIPT);
        }

        return ContentService.createTextOutput(jsonResponse)
            .setMimeType(ContentService.MimeType.JSON);
    }
    catch (err)
    {
        const errorResponse = JSON.stringify({ success: false, error: err.message });
        
        if (e && e.parameter && e.parameter.callback)
        {
            return ContentService.createTextOutput(e.parameter.callback + "(" + errorResponse + ")")
                .setMimeType(ContentService.MimeType.JAVASCRIPT);
        }

        return ContentService.createTextOutput(errorResponse)
            .setMimeType(ContentService.MimeType.JSON);
    }
}

function doPost(e)
{
    return doGet(e);
}

function sendTempPinEmail(spielerId, tempPin)
{
    try
    {
        const props = PropertiesService.getScriptProperties();
        const ssAdminUrl = props.getProperty("ssAdmin");
        
        if (!ssAdminUrl)
        {
            throw new Error("Skripteigenschaft 'ssAdmin' fehlt!");
        }

        const ssAdmin = SpreadsheetApp.openByUrl(ssAdminUrl);
        const tSpieler = ssAdmin.getSheetByName("adm_Spieler");

        if (!tSpieler)
        {
            throw new Error("Tabelle 'adm_Spieler' nicht gefunden.");
        }

        const spielerData = tSpieler.getDataRange().getValues();
        let spielerEmail = "";
        let spielerName = "";

        for (let i = 1; i < spielerData.length; i++)
        {
            if (String(spielerData[i][0]).trim() === String(spielerId).trim())
            {
                spielerName = String(spielerData[i][2] || spielerData[i][1]).trim();
                spielerEmail = String(spielerData[i][3]).trim();
                break;
            }
        }

        if (!spielerEmail || !spielerEmail.includes("@"))
        {
            throw new Error("Für diesen Spieler ist keine gültige E-Mail-Adresse hinterlegt!");
        }

        const subject = "Dein Einmal-Code für die LIE Scorecard";
        const bodyText = `Hallo ${spielerName},\n\ndein Einmal-Code lautet: ${tempPin}\n\nBitte gib diesen Code in der LIE Scorecard App unter https://app.lochihnein.de ein.\n\nSportliche Grüße,\nDein LIE Scorecard Team`;
        
        MailApp.sendEmail(spielerEmail, subject, bodyText);

        return { message: "E-Mail erfolgreich versendet" };
    }
    catch (err)
    {
        return { error: err.toString() };
    }
}





