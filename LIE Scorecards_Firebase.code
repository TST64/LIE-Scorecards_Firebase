                <iframe id="pixel-golf-iframe" src="about:blank" class="w-full h-full border-0" allow="autoplay"></iframe>
            </div>
        </div>
    </div>

    <!-- Dynamisches Skript-Laden -->
    <script>
        (function() 
        {
            const cfgScript = document.createElement('script');
            cfgScript.src = 'config.js?t=' + Date.now();
            cfgScript.async = false;

            cfgScript.onload = function() 
            {
                const scripts = [
                    "App_Core.js",
                    "App_View_Help.js",
                    "App_Router.js",
                    "App_Logic_Bridge.js",
                    "App_Logic_Scores.js",
                    "App_Logic_Spieltage.js",
                    "App_Logic_Spieler.js",
                    "App_Logic_UI.js",
                    "Views_Login.js",
                    "Views_Dashboard.js",
                    "Views_Spieltage.js",
                    "Views_SpieltagNeu.js",
                    "Views_ScoreEingabe.js",
                    "Views_Leaderboard.js",
                    "Views_Admin.js",
                    "Views_AdminGruppe.js",
                    "Views_SpielerEdit.js",
                    "App_Start.js"
                ];

                const version = (typeof CONFIG !== 'undefined' && CONFIG.appVersion) 
                    ? CONFIG.appVersion 
                    : Date.now();

                let loadedCount = 0;

                scripts.forEach(function(src) 
                {
                    const script = document.createElement('script');
                    script.src = src + '?v=' + encodeURIComponent(version);
                    script.async = false;
                    
                    script.onload = function() 
                    {
                        loadedCount++;
                        if (loadedCount === scripts.length) 
                        {
                            if (window.app && typeof window.app.initStart === 'function') 
                            {
                                window.app.initStart();
                            }
                        }
                    };

                    document.head.appendChild(script);
                });
            };

            document.head.appendChild(cfgScript);
        })();
    </script>
</body>
</html>


##### <Style.css>:
----------------------------------------------------------------------
/* =========================================================================
   BMAssistent / LIE Scorecard - Modern Apple / Glassmorphism Theme
   Style.css
   BSD (Allman) Style
   ========================================================================= */

:root
{
    --color-header-bg: #042f2e;       /* Deep Midnight Emerald */
    --color-bg-body: #f8fafc;         /* Ultra-clean Slate 50 */
    --color-card-bg: rgba(255, 255, 255, 0.85);
    --color-emerald-accent: #059669;  /* Modern Emerald 600 */
    --color-amber-accent: #d97706;    /* Warm Amber 600 */
}

html, body
{
    width: 100%;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    background-color: var(--color-bg-body);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
}

/* App Shell Canvas mit modernem Glassmorphism-Schatten */
#app-container
{
    width: 100%;
    box-sizing: border-box;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Deaktiviert die unschöne graue Tap-Fläche auf Mobilgeräten */
button, a, .nav-btn
{
    -webkit-tap-highlight-color: transparent;
    outline: none;
}

/* One-Hand Safe Input Targets */
.touch-target
{
    min-height: 44px;
    min-width: 44px;
}

/* Custom Scrollbar für Loch-Navigation & Listen */
.scrollbar-none::-webkit-scrollbar
{
    display: none;
}
.scrollbar-none
{
    -ms-overflow-style: none;
    scrollbar-width: none;
}

/* Sanfte Animationen */
@keyframes fadeIn 
{
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
}

.animate-fade-in 
{
    animation: fadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
```[cite: 4]

