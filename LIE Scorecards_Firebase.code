                    <div class="mt-3">
                        <span class="block font-black text-amber-950 text-sm">Pixel Golf Run starten</span>
                        <span class="block text-[10px] text-amber-700 font-medium mt-0.5">Teste deine Skills im Arcade-Modus ⛳</span>
                    </div>
                </button>
            </div>
        </div>
    `;
