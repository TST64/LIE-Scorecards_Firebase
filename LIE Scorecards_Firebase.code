<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LIE Scorecard</title>

    <!-- Tailwind CSS & FontAwesome via CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <!-- Firebase Web SDK (v10 Compat Mode) -->
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-functions-compat.js"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="Style.css?v=3">

    <!-- Favicon / App-Icon -->
    <link rel="icon" type="image/jpeg" href="img/LIE_Logo II.jpeg">
    <link rel="apple-touch-icon" href="img/LIE_Logo II.jpeg">

    <!-- PWA Manifest & Mobile Styling -->
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#064e3b">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="LIE Scorecard">
</head>
<body class="bg-zinc-100 text-zinc-900 font-sans antialiased">

    <!-- Globale Namespace Initialisierung -->
    <script>
        window.app = window.app || {};
        app.views = app.views || {};
        app.logic = app.logic || {};
        app.router = app.router || {};
    </script>

    <!-- App Shell Wrapper -->
    <div class="w-full max-w-md md:max-w-2xl lg:max-w-4xl mx-auto min-h-screen bg-white shadow-2xl border-x border-zinc-200/60 flex flex-col">
        
        <!-- Header in Clean Tech Emerald -->
        <header class="bg-teal-900 text-white px-3 sm:px-4 py-2.5 sm:py-3 sticky top-0 z-40 shadow-md flex justify-between items-center border-b border-teal-800/80">
            <div class="flex items-center space-x-1.5 min-w-0">
                <h1 onclick="app.router.navigate('dashboard')" class="text-base sm:text-lg font-black tracking-wider uppercase text-teal-50 truncate cursor-pointer hover:text-white transition">LIE Scorecard</h1>
                <button onclick="app.router.navigate('hilfe')" class="text-teal-200 hover:text-white p-1 touch-target text-xs sm:text-sm transition focus:outline-none" title="Handbuch & Versions-Info">
                    <i class="fas fa-question-circle"></i>
                </button>
            </div>

            <div class="flex items-center space-x-1.5 sm:space-x-2.5 shrink-0">
                <button onclick="app.router.navigate('golfplaetze')" class="text-teal-200 hover:text-white p-1 touch-target text-sm sm:text-base transition focus:outline-none" title="Golfplätze anzeigen">
                    <i class="fas fa-map-marked-alt"></i>
                </button>
                <button onclick="app.router.navigate('live_dashboard')" class="text-teal-200 hover:text-white p-1 touch-target text-sm sm:text-base transition focus:outline-none" title="Saison Live-Dashboard">
                    <i class="fas fa-chart-line"></i>
                </button>
                <button onclick="app.router.navigate('wetter')" class="text-teal-200 hover:text-white p-1 touch-target text-sm sm:text-base transition focus:outline-none" title="Platzwetter anzeigen">
                    <i class="fas fa-cloud-sun"></i>
                </button>
                <button id="global-refresh-btn" onclick="app.logic.refreshGlobalAppData()" class="text-teal-200 hover:text-white p-1 touch-target text-sm sm:text-base transition focus:outline-none" title="Daten aktualisieren">
                    <i id="global-refresh-icon" class="fas fa-sync-alt"></i>
                </button>
                <span id="header-role-badge" class="flex items-center text-xs opacity-75"></span>
                <button id="header-logout-btn" onclick="app.logic.logout()" class="hidden text-teal-200 hover:text-white p-1 touch-target text-xs sm:text-sm transition focus:outline-none" title="Abmelden">
                    <i class="fas fa-sign-out-alt"></i>
                </button>
                <div id="connection-status" class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-teal-400 shadow-xs"></div>
            </div>
        </header>

        <!-- Main Content Area -->
        <main id="app-container" class="flex-1 p-4 pb-24">
            <!-- Splash Screen -->
            <div id="app-loading" class="flex flex-col items-center justify-center pt-16 space-y-6">
                <div class="w-44 h-44 bg-zinc-50 border border-zinc-200 rounded-3xl p-2 shadow-lg flex items-center justify-center overflow-hidden">
                    <img id="splash-logo" src="img/LIE_Logo II.jpeg" alt="LIE Logo" class="w-full h-full object-cover rounded-2xl" />
                </div>
                <div class="flex flex-col items-center space-y-2">
                    <i class="fas fa-circle-notch fa-spin text-2xl text-teal-600"></i>
                    <p class="text-zinc-500 text-xs font-bold uppercase tracking-widest">Lade Clubhaus-Daten...</p>
                </div>
            </div>
        </main>

        <!-- Mobile Navigation Footer -->
        <nav id="bottom-nav" class="fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-md bg-white/95 backdrop-blur-md border-t border-zinc-200/80 py-2 px-3 flex justify-around items-center z-40 shadow-xl">
            <button id="nav-dash" onclick="app.router.navigate('dashboard')" class="nav-btn flex flex-col items-center text-zinc-400 hover:text-teal-700 transition px-2 py-1 touch-target">
                <i class="fas fa-home text-base"></i>
                <span class="text-[10px] font-semibold mt-0.5">Home</span>
            </button>
            <button id="nav-stats" onclick="app.router.navigate('live_dashboard')" class="nav-btn flex flex-col items-center text-zinc-400 hover:text-teal-700 transition px-2 py-1 touch-target">
                <i class="fas fa-chart-bar text-base"></i>
                <span class="text-[10px] font-semibold mt-0.5">Stats</span>
            </button>
            <button id="nav-rounds" onclick="app.router.navigate('spieltage')" class="nav-btn flex flex-col items-center text-zinc-400 hover:text-teal-700 transition px-2 py-1 touch-target">
                <i class="fas fa-calendar-alt text-base"></i>
                <span class="text-[10px] font-semibold mt-0.5">Runden</span>
            </button>
            <button id="nav-calendar" onclick="app.router.navigate('kalender')" class="nav-btn flex flex-col items-center text-zinc-400 hover:text-teal-600 transition px-2 py-1 touch-target">
                <i class="fas fa-calendar-days text-base"></i>
                <span class="text-[10px] font-semibold mt-0.5">Kalender</span>
            </button>
            <button id="nav-players" onclick="app.router.navigate('spieler')" class="nav-btn flex flex-col items-center text-zinc-400 hover:text-teal-700 transition px-2 py-1 touch-target">
                <i class="fas fa-users text-base"></i>
                <span class="text-[10px] font-semibold mt-0.5">Gruppe</span>
            </button>
            <button id="nav-admin" onclick="app.router.navigate('admin')" class="nav-btn flex flex-col items-center text-zinc-400 hover:text-amber-600 transition px-2 py-1 touch-target hidden">
                <i class="fas fa-user-shield text-base"></i>
                <span class="text-[10px] font-semibold mt-0.5">Admin</span>
            </button>
        </nav>

    </div>

    <!-- Globaler Toast Container -->
    <div id="global-toast-container" class="fixed bottom-20 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 w-full max-w-sm px-4 pointer-events-none"></div>

    <!-- Globales Confirmation Modal -->
    <div id="global-confirm-modal" class="fixed inset-0 z-[80] bg-stone-900/60 backdrop-blur-xs hidden flex items-center justify-center p-4">
        <div id="confirm-modal-box" class="bg-white rounded-2xl max-w-xs w-full p-5 space-y-4 shadow-2xl transition-all duration-200 opacity-0 scale-95 border border-stone-100">
            <div class="flex items-start space-x-3">
                <div id="confirm-modal-icon-container" class="w-10 h-10 rounded-full flex items-center justify-center text-lg flex-shrink-0 bg-teal-100 text-teal-700">
                    <i id="confirm-modal-icon" class="fas fa-question-circle text-sm"></i>
                </div>
                <div class="space-y-1">
                    <h3 id="confirm-modal-title" class="font-bold text-stone-800 text-sm">Titel</h3>
                    <p id="confirm-modal-message" class="text-stone-500 text-xs leading-relaxed">Nachricht</p>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-2 pt-2">
                <button id="confirm-modal-cancel" class="bg-stone-100 hover:bg-stone-200 text-stone-700 font-bold py-2.5 rounded-xl text-xs transition">Abbrechen</button>
                <button id="confirm-modal-submit" class="bg-teal-600 hover:bg-teal-700 text-white font-bold py-2.5 rounded-xl text-xs transition shadow-xs">Bestätigen</button>
            </div>
        </div>
    </div>

    <!-- Dynamisches Skript-Laden -->
    <script>
        (function() 
        {
            const cfgScript = document.createElement('script');
            cfgScript.src = 'config.js?t=' + Date.now();
            cfgScript.async = false;

            cfgScript.onload = function() 
            {
                const scripts = [
                    "App_Core.js",
                    "App_View_Help.js",
                    "App_Router.js",
                    "App_Logic_Bridge.js",
                    "App_Logic_Scores.js",
                    "App_Logic_Spieltage.js",
                    "App_Logic_History.js",
                    "App_Logic_Performance.js",
                    "App_Logic_Spieler.js",
                    "App_Logic_UI.js",
                    "Views_Login.js",
                    "Views_Dashboard.js",
                    "Views_LiveDashboard.js",
                    "Views_Performance.js",
                    "Views_Spieltage.js",
                    "Views_SpieltagNeu.js",
                    "Views_ScoreEingabe.js",
                    "Views_ScoreSchnellerfassung.js",
                    "Views_Leaderboard.js",
                    "Views_Admin.js",
                    "Views_AdminKorrektur.js",
                    "Views_AdminGruppe.js",
                    "Views_SpielerEdit.js",
                    "App_Start.js",
                    "Views_Kalender.js",
                    "Views_Wetter.js",
                    "Views_Golfplaetze.js"
                ];

                const version = (typeof CONFIG !== 'undefined' && CONFIG.appVersion) 
                    ? CONFIG.appVersion 
                    : Date.now();

                let loadedCount = 0;

                scripts.forEach(function(src) 
                {
                    const script = document.createElement('script');
                    script.src = src + '?v=' + encodeURIComponent(version);
                    script.async = false;
                    
                    script.onload = function() 
                    {
                        loadedCount++;
                        if (loadedCount === scripts.length) 
                        {
                            if (window.app && typeof window.app.initStart === 'function') 
                            {
                                window.app.initStart();
                            }
                        }
                    };

                    document.head.appendChild(script);
                });
            };

            document.head.appendChild(cfgScript);
        })();
    </script>
</body>
</html>




##### <Style.css>:
----------------------------------------------------------------------
/* =========================================================================
   BMAssistent / LIE Scorecard - Modern Apple / Glassmorphism Theme 2.0
   Style.css
   BSD (Allman) Style
   ========================================================================= */

   @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

   :root
   {
       /* Angepasste Farbpalette für mehr Leuchtkraft */
       --color-header-bg: rgba(4, 47, 46, 0.88); /* Deep Emerald mit Transparenz für Glass-Effekt */
       --color-emerald-accent: #10b981;  /* Fresher, brighter Emerald */
       --color-amber-accent: #f59e0b;    /* Brighter, warmer Amber */
   }
   
   html, body
   {
       width: 100%;
       margin: 0;
       padding: 0;
       overflow-x: hidden;
       /* Subtiler, moderner Farbverlauf statt flachem Grau für mehr Premium-Gefühl */
       background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
       background-attachment: fixed;
       /* Neue Premium-Schriftart 'Inter' als Fallback-Kaskade */
       font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
       -webkit-font-smoothing: antialiased;
       -moz-osx-font-smoothing: grayscale;
   }
   
   /* App Shell Canvas */
   #app-container
   {
       width: 100%;
       box-sizing: border-box;
       transition: opacity 0.3s ease;
   }
   
   /* ==========================================
      Glassmorphism & Apple-like UI Overrides
      ========================================== */
   
   /* Header bekommt echten Milchglas-Effekt */
   header 
   {
       background-color: var(--color-header-bg) !important;
       backdrop-filter: blur(12px);
       -webkit-backdrop-filter: blur(12px);
       border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
   }
   
   /* Bottom Nav bekommt echten Milchglas-Effekt */
   #bottom-nav 
   {
       background-color: rgba(255, 255, 255, 0.85) !important;
       backdrop-filter: blur(16px);
       -webkit-backdrop-filter: blur(16px);
       border-top: 1px solid rgba(0, 0, 0, 0.05) !important;
       box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.03) !important;
   }
   
   /* Karten-Schatten weicher machen (Apple Style) */
   .bg-white, .bg-stone-50 
   {
       box-shadow: 0 4px 24px rgba(0, 0, 0, 0.02), 0 1px 3px rgba(0, 0, 0, 0.01) !important;
   }
   
   /* ==========================================
      Interaction & Feedback (UX)
      ========================================== */
   
   /* Deaktiviert die unschöne graue Tap-Fläche auf Android/iOS */
   button, a, .nav-btn, input, select
   {
       -webkit-tap-highlight-color: transparent;
       outline: none;
   }
   
   /* Sanftes taktiles Feedback für ALLE Buttons (iOS Feeling) */
   button 
   {
       transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.2s ease, opacity 0.2s ease;
   }
   
   button:active 
   {
       transform: scale(0.96);
   }
   
   /* Ausnahme für die Navigationsleiste unten, damit sie organisch drückt */
   #bottom-nav button:active 
   {
       transform: scale(0.90);
   }
   
   /* One-Hand Safe Input Targets */
   .touch-target
   {
       min-height: 44px;
       min-width: 44px;
   }
   
   /* ==========================================
      Utilities
      ========================================== */
   
   /* Custom Scrollbar für Loch-Navigation & Listen */
   .scrollbar-none::-webkit-scrollbar
   {
       display: none;
   }
   .scrollbar-none
   {
       -ms-overflow-style: none;
       scrollbar-width: none;
   }
   
   /* Weichere, flüssigere Einblend-Animationen */
   @keyframes fadeIn 
   {
       from { opacity: 0; transform: translateY(8px); }
       to { opacity: 1; transform: translateY(0); }
   }
   
   .animate-fade-in 
   {
       animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
   }





