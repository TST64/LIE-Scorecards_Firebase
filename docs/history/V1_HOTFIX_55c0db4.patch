diff --git a/tests/v1-score-safety.test.cjs b/tests/v1-score-safety.test.cjs
new file mode 100644
index 0000000..a8119d4
--- /dev/null
+++ b/tests/v1-score-safety.test.cjs
@@ -0,0 +1,546 @@
+'use strict';
+
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const { test } = require('node:test');
+
+// Run: node --test tests/v1-score-safety.test.cjs
+// No Firebase SDK, network API or real database is loaded.
+const root = path.resolve(__dirname, '..');
+
+function noop()
+{
+}
+
+function fixture()
+{
+    const state = {
+        spieltage: [{ id: 'ST', kursId: 'K', teilnehmerCsv: 'A,B,C,D', status: 'Aktiv' }],
+        flights: [
+            { id: 'FL-ST-1', spieltagId: 'ST', spielerIdsCsv: 'A,B' },
+            { id: 'FL-ST-2', spieltagId: 'ST', spielerIdsCsv: 'C,D' }
+        ],
+        spieler: ['A', 'B', 'C', 'D'].map(function(id)
+        {
+            return { id: id, name: id, nickname: id, hcpLIE: 18 };
+        }),
+        kurse: [{ id: 'K', name: 'Testkurs', bahnAnzahl: 18 }],
+        bahnen: [{ kursId: 'K', nr: 1, par: 4, si: 1 }],
+        handicaps: [],
+        currentUser: { id: 'A', role: 'Admin' },
+        liveScores: {},
+        scoreCards: []
+    };
+    const writes = [];
+    const requests = [];
+    const messages = [];
+    let commitCount = 0;
+    const db = {
+        collection: function(name)
+        {
+            assert.equal(name, 'scorecards');
+            return {
+                doc: function(id)
+                {
+                    return { id: id };
+                }
+            };
+        },
+        batch: function()
+        {
+            return {
+                set: function(ref, data, options)
+                {
+                    writes.push({ id: ref.id, data: structuredClone(data), options: options });
+                },
+                commit: async function()
+                {
+                    commitCount++;
+                }
+            };
+        }
+    };
+    const context = vm.createContext({
+        app: { state: state, logic: {}, views: {}, db: db },
+        document: {
+            getElementById: function()
+            {
+                return null;
+            }
+        },
+        console: { log: noop, warn: noop, error: noop }
+    });
+    for (const file of ['App_Logic_Scores.js', 'App_Logic_Bridge.js',
+        'App_Logic_Spieltage.js', 'Views_ScoreEingabe.js', 'Views_ScoreSchnellerfassung.js'])
+    {
+        vm.runInContext(fs.readFileSync(path.join(root, file), 'utf8'), context, { filename: file });
+    }
+    const logic = context.app.logic;
+    logic.showToast = function(message, kind)
+    {
+        messages.push({ message: message, kind: kind });
+    };
+    logic.stopLivePolling = noop;
+    logic.startLivePolling = noop;
+    const realApi = logic.apiRequest;
+    logic.apiRequest = async function(action, payload)
+    {
+        requests.push(structuredClone(payload.payload));
+        return realApi(action, payload);
+    };
+    return {
+        state: state, logic: logic, views: context.app.views, document: context.document,
+        writes: writes, requests: requests, messages: messages,
+        commits: function()
+        {
+            return commitCount;
+        },
+        bridge: function(payload)
+        {
+            return realApi('saveLiveScores', payload);
+        }
+    };
+}
+
+function deferredSave(f)
+{
+    let resolve;
+    f.logic.apiRequest = function(action, payload)
+    {
+        f.requests.push(structuredClone(payload.payload));
+        return new Promise(function(done)
+        {
+            resolve = done;
+        });
+    };
+    return function(response)
+    {
+        resolve(response);
+    };
+}
+
+test('1/2/6: only explicit flight is sent and acknowledged; foreign entries remain', async function()
+{
+    const f = fixture();
+    f.state.liveScores = { ST_A_1: 5, ST_B_1: 6, ST_C_1: 4, ST_D_2: 7, ST_X_1: 8 };
+    const result = await f.logic.syncScoresWithServer('ST', 2);
+    assert.equal(result.success, true);
+    assert.deepEqual(f.requests[0].map(function(sc)
+    {
+        return [sc.spielerId, sc.flightSeq, sc.hole];
+    }), [['C', 2, 1], ['D', 2, 2]]);
+    assert.deepEqual(f.state.liveScores, { ST_A_1: 5, ST_B_1: 6, ST_X_1: 8 });
+});
+
+test('3/4: changed value survives ACK; unchanged sent fields are removed', async function()
+{
+    const f = fixture();
+    f.state.liveScores = { ST_A_1: 5, ST_A_1_puts: 2, ST_A_1_lady: false };
+    const finish = deferredSave(f);
+    const saved = f.logic.syncScoresWithServer('ST', 1);
+    f.state.liveScores.ST_A_1 = 6;
+    f.state.liveScores.ST_A_1_lady = true;
+    f.state.liveScores.ST_A_2 = 7;
+    finish({ success: true });
+    await saved;
+    assert.deepEqual(f.state.liveScores, { ST_A_1: 6, ST_A_1_lady: true, ST_A_2: 7 });
+    assert.equal(f.requests[0][0].strokes, 5);
+});
+
+for (const seq of [0, -1, 3, '2junk', 1.5, undefined])
+{
+    test('5: invalid flight ' + seq + ' produces no writes', async function()
+    {
+        const f = fixture();
+        f.state.liveScores.ST_A_1 = 5;
+        assert.equal((await f.logic.syncScoresWithServer('ST', seq)).success, false);
+        assert.equal(f.writes.length, 0);
+        assert.equal(f.state.liveScores.ST_A_1, 5);
+    });
+}
+
+test('ambiguous round, flight and member contexts are rejected', async function()
+{
+    for (const kind of ['round', 'flight', 'member', 'missingPlayer'])
+    {
+        const f = fixture();
+        f.state.liveScores.ST_A_1 = 5;
+        if (kind === 'round')
+        {
+            f.state.spieltage.push({ id: 'ST' });
+        }
+        else if (kind === 'flight')
+        {
+            f.state.flights.push({ id: 'other-1', spieltagId: 'ST', spielerIdsCsv: 'C' });
+        }
