+test('9: independent flights can have simultaneous requests', async function()
+{
+    const f = fixture();
+    f.state.liveScores = { ST_A_1: 5, ST_C_1: 6 };
+    const resolvers = [];
+    f.logic.apiRequest = function(action, payload)
+    {
+        f.requests.push(structuredClone(payload.payload));
+        return new Promise(function(resolve)
+        {
+            resolvers.push(resolve);
+        });
+    };
+    const one = f.logic.syncScoresWithServer('ST', 1);
+    const two = f.logic.syncScoresWithServer('ST', 2);
+    assert.equal(f.requests.length, 2);
+    resolvers[1]({ success: true });
+    await two;
+    assert.equal(f.state.liveScores.ST_A_1, 5);
+    resolvers[0]({ success: true });
+    await one;
+    assert.deepEqual(f.state.liveScores, {});
+});
